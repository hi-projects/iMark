{
  "name": "agent",
  "publisher": "imark",
  "version": "1.0.0",
  "displayName": "Agent Core",
  "description": "Agent 对话宿主：会话、附件、提示词与权限模式；具体后端由 Agent provider 扩展提供",
  "author": "iMark",
  "engines": { "imark": "^1.0.0" },
  "main": "./main.js",
  "icon": "./icon.svg",
  "activationEvents": [
    "onStartupFinished",
    "onCommand:imark.agent.openChat",
    "onCommand:imark.agent.beautify",
    "onCommand:imark.agent.stop",
    "onWebviewPanel:imark.agent.chat"
  ],
  "capabilities": {
    "filesystem": "user",
    "process": true
  },
  "contributes": {
    "commands": [
      {
        "command": "imark.agent.openChat",
        "title": "打开 Agent Core 对话",
        "category": "Agent Core"
      },
      {
        "command": "imark.agent.beautify",
        "title": "Agent Core 整理当前文档",
        "category": "Agent Core"
      },
      {
        "command": "imark.agent.stop",
        "title": "停止 Agent Core 运行",
        "category": "Agent Core"
      }
    ],
    "configuration": {
      "title": "Agent Core",
      "properties": {
        "imark.agent.mode": {
          "type": "string",
          "default": "read+parse",
          "enum": ["read+parse", "read-only"],
          "title": "权限模式",
          "description": "read+parse：允许 Agent 运行解析命令并写入会话目录，附件由 Agent 自行读取。read-only：只允许读取，PDF 需要模型原生支持；无法解析时 Agent 会明确说明。",
          "imark": {
            "kind": "select",
            "section": "Agent Core"
          }
        },
        "imark.agent.attachmentMaxMB": {
          "type": "number",
          "default": 32,
          "minimum": 1,
          "maximum": 100,
          "title": "单个附件上限（MB）",
          "description": "超过上限的文件会在上传阶段被拒绝；扩展不解析附件内容。",
          "imark": {
            "kind": "number",
            "section": "附件"
          }
        }
      }
    }
  }
}
