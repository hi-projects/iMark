{
  "name": "agent",
  "publisher": "imark",
  "version": "1.0.0",
  "displayName": "Agent Core",
  "description": "Agent 对话宿主：会话、附件与提示词；具体后端由 Agent provider 扩展提供",
  "author": "iMark",
  "engines": { "imark": "^1.0.0" },
  "main": "./main.js",
  "icon": "./icon.svg",
  "activationEvents": [
    "onStartupFinished",
    "onCommand:imark.agent.openChat",
    "onCommand:imark.agent.stop",
    "onWebviewPanel:imark.agent.chat"
  ],
  "capabilities": {
    "filesystem": "user",
    "process": true
  },
  "contributes": {
    "commands": [
      {
        "command": "imark.agent.openChat",
        "title": "打开 Agent Core 对话",
        "category": "Agent Core"
      },
      {
        "command": "imark.agent.stop",
        "title": "停止 Agent Core 运行",
        "category": "Agent Core"
      }
    ],
    "configuration": {
      "title": "Agent Core",
      "properties": {
        "imark.agent.systemPrompt": {
          "type": "string",
          "default": "",
          "title": "系统提示词",
          "description": "每轮对话最前面的系统规则。清空或点右侧图标即恢复内置默认。",
          "imark": {
            "kind": "textarea",
            "label": "提示词内容",
            "section": "系统提示词",
            "rows": 12,
            "resettable": true,
            "placeholder": "留空则使用内置默认提示词"
          }
        },
        "imark.agent.attachmentMaxMB": {
          "type": "number",
          "default": 32,
          "minimum": 1,
          "maximum": 100,
          "title": "单个附件上限（MB）",
          "description": "超过上限的文件会在上传阶段被拒绝；扩展不解析附件内容。",
          "imark": {
            "kind": "number",
            "section": "附件"
          }
        }
      }
    }
  }
}
