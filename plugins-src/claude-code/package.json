{
  "name": "claude-code",
  "publisher": "imark",
  "version": "1.0.0",
  "displayName": "Claude Code",
  "description": "为 Agent Core 提供 Claude Code 后端：调用本机 Claude Code CLI，支持流式输出、工具时间线与会话续接",
  "author": "iMark",
  "engines": { "imark": "^1.0.0" },
  "main": "./main.js",
  "icon": "./icon.svg",
  "activationEvents": ["onCommand:imark.claude-code.check"],
  "extensionDependencies": ["imark.agent"],
  "capabilities": {
    "filesystem": "user",
    "network": true,
    "process": true,
    "shell": true
  },
  "contributes": {
    "imark.agentProviders": ["claude-code"],
    "commands": [
      {
        "command": "imark.claude-code.check",
        "title": "检查 Claude Code",
        "category": "Claude Code"
      }
    ],
    "configuration": {
      "title": "Claude Code",
      "properties": {
        "imark.claude-code.commandMode": {
          "type": "string",
          "default": "auto",
          "enum": ["auto", "manual"],
          "enumDescriptions": ["自动检测", "手动指定"],
          "title": "Claude Code 可执行文件",
          "description": "自动检测：依次查找 PATH、~/.local/bin，以及 VS Code / Insiders / Server、VSCodium、Cursor、Windsurf 扩展自带的 claude。手动指定：填写可执行文件的完整路径。",
          "imark": {
            "kind": "select",
            "section": "Claude Code"
          }
        },
        "imark.claude-code.command": {
          "type": "string",
          "default": "",
          "title": "可执行文件路径",
          "description": "手动指定时使用。可以填 claude / claude.exe / claude.cmd 的完整路径；留空会回退到自动检测。",
          "imark": {
            "kind": "text",
            "section": "Claude Code",
            "showWhen": { "key": "commandMode", "value": "manual" },
            "placeholder": "例如 /usr/local/bin/claude"
          }
        },
        "imark.claude-code.effort": {
          "type": "string",
          "default": "",
          "title": "推理强度",
          "description": "写入 env.CLAUDE_CODE_EFFORT_LEVEL。留空表示不设置，由 CLI 自己决定。",
          "imark": {
            "kind": "external",
            "section": "Claude Code（settings.json）",
            "file": "~/.claude/settings.json",
            "dirEnv": "CLAUDE_CONFIG_DIR",
            "pointer": "/env/CLAUDE_CODE_EFFORT_LEVEL",
            "options": [
              { "value": "low", "label": "low" },
              { "value": "medium", "label": "medium" },
              { "value": "high", "label": "high" },
              { "value": "xhigh", "label": "xhigh" },
              { "value": "max", "label": "max" },
              { "value": "auto", "label": "auto" }
            ]
          }
        },
        "imark.claude-code.extraArgs": {
          "type": "array",
          "default": [],
          "title": "额外参数",
          "description": "每项一个参数，按顺序追加到 claude 命令行。会拒绝改变协议、配置或会话归属的参数（如 -p、--output-format、--session-id）。",
          "imark": {
            "kind": "list",
            "section": "Claude Code",
            "placeholder": "输入一个参数，例如 --debug"
          }
        },
        "imark.claude-code.baseUrl": {
          "type": "string",
          "default": "",
          "title": "API 端点",
          "description": "写入 settings.json 的 env.ANTHROPIC_BASE_URL。DeepSeek 填 https://api.deepseek.com/anthropic；留空表示不设置。",
          "imark": {
            "kind": "external",
            "section": "Claude Code（settings.json）",
            "file": "~/.claude/settings.json",
            "dirEnv": "CLAUDE_CONFIG_DIR",
            "pointer": "/env/ANTHROPIC_BASE_URL",
            "placeholder": "https://api.deepseek.com/anthropic"
          }
        },
        "imark.claude-code.authToken": {
          "type": "string",
          "default": "",
          "title": "认证令牌",
          "description": "写入 env.ANTHROPIC_AUTH_TOKEN（Authorization: Bearer）。DeepSeek 等 Anthropic 兼容端点通常用它；与 API 密钥同时设置时 AUTH_TOKEN 优先。",
          "imark": {
            "kind": "external",
            "section": "Claude Code（settings.json）",
            "file": "~/.claude/settings.json",
            "dirEnv": "CLAUDE_CONFIG_DIR",
            "pointer": "/env/ANTHROPIC_AUTH_TOKEN",
            "secret": true,
            "placeholder": "留空表示不设置"
          }
        },
        "imark.claude-code.apiKey": {
          "type": "string",
          "default": "",
          "title": "API 密钥",
          "description": "写入 env.ANTHROPIC_API_KEY（x-api-key）。官方 Anthropic API 用它；与 AUTH_TOKEN 同时设置时以 AUTH_TOKEN 为准。",
          "imark": {
            "kind": "external",
            "section": "Claude Code（settings.json）",
            "file": "~/.claude/settings.json",
            "dirEnv": "CLAUDE_CONFIG_DIR",
            "pointer": "/env/ANTHROPIC_API_KEY",
            "secret": true,
            "placeholder": "留空表示不设置"
          }
        },
        "imark.claude-code.model": {
          "type": "string",
          "default": "",
          "title": "默认模型",
          "description": "写入 env.ANTHROPIC_MODEL，作为 CLI 的默认模型；对话面板只读显示这个值，不提供模型选择。",
          "imark": {
            "kind": "external",
            "section": "Claude Code（settings.json）",
            "file": "~/.claude/settings.json",
            "dirEnv": "CLAUDE_CONFIG_DIR",
            "pointer": "/env/ANTHROPIC_MODEL",
            "placeholder": "例如 deepseek-flash[1m]"
          }
        },
        "imark.claude-code.opusModel": {
          "type": "string",
          "default": "",
          "title": "Opus 别名模型",
          "description": "写入 env.ANTHROPIC_DEFAULT_OPUS_MODEL。Claude Code 使用 Opus 别名时映射到的模型 ID。",
          "imark": {
            "kind": "external",
            "section": "Claude Code（settings.json）",
            "file": "~/.claude/settings.json",
            "dirEnv": "CLAUDE_CONFIG_DIR",
            "pointer": "/env/ANTHROPIC_DEFAULT_OPUS_MODEL",
            "placeholder": "例如 deepseek-flash[1m]"
          }
        },
        "imark.claude-code.sonnetModel": {
          "type": "string",
          "default": "",
          "title": "Sonnet 别名模型",
          "description": "写入 env.ANTHROPIC_DEFAULT_SONNET_MODEL。Claude Code 使用 Sonnet 别名时映射到的模型 ID。",
          "imark": {
            "kind": "external",
            "section": "Claude Code（settings.json）",
            "file": "~/.claude/settings.json",
            "dirEnv": "CLAUDE_CONFIG_DIR",
            "pointer": "/env/ANTHROPIC_DEFAULT_SONNET_MODEL",
            "placeholder": "例如 deepseek-flash[1m]"
          }
        },
        "imark.claude-code.haikuModel": {
          "type": "string",
          "default": "",
          "title": "Haiku 别名模型",
          "description": "写入 env.ANTHROPIC_DEFAULT_HAIKU_MODEL。Claude Code 使用 Haiku 别名时映射到的模型 ID。",
          "imark": {
            "kind": "external",
            "section": "Claude Code（settings.json）",
            "file": "~/.claude/settings.json",
            "dirEnv": "CLAUDE_CONFIG_DIR",
            "pointer": "/env/ANTHROPIC_DEFAULT_HAIKU_MODEL",
            "placeholder": "例如 deepseek-flash"
          }
        },
        "imark.claude-code.subagentModel": {
          "type": "string",
          "default": "",
          "title": "子代理模型",
          "description": "写入 env.CLAUDE_CODE_SUBAGENT_MODEL。留空表示不设置。",
          "imark": {
            "kind": "external",
            "section": "Claude Code（settings.json）",
            "file": "~/.claude/settings.json",
            "dirEnv": "CLAUDE_CONFIG_DIR",
            "pointer": "/env/CLAUDE_CODE_SUBAGENT_MODEL",
            "placeholder": "例如 deepseek-flash"
          }
        },
        "imark.claude-code.timeoutSec": {
          "type": "number",
          "default": 3600,
          "minimum": 10,
          "maximum": 7200,
          "title": "单轮超时（秒）",
          "description": "超过这个时间会终止 Agent 子进程；文档和会话不会改动。",
          "imark": {
            "kind": "number",
            "section": "扩展调用"
          }
        },
        "imark.claude-code.maxTurns": {
          "type": "number",
          "default": 300,
          "minimum": 1,
          "maximum": 1000,
          "title": "单轮最大工具轮数",
          "description": "Agent 单次回答最多允许多少个 assistant 轮次；超过后宿主会终止子进程。",
          "imark": {
            "kind": "number",
            "section": "扩展调用"
          }
        }
      }
    },
    "imark.actions": [
      {
        "command": "imark.claude-code.check",
        "label": "检查 Claude Code",
        "scope": "global",
        "primary": true
      }
    ]
  }
}
