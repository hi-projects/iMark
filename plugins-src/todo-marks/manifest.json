{
  "id": "todo-marks",
  "name": "待办标记",
  "description": "把正文里的 TODO / FIXME 标出来并列在侧栏,点一条跳到那一行。编辑器扩展点 + 停靠面板的样板。",
  "version": "1.0.0",
  "author": "iMark",
  "kind": "sandboxed",
  "main": "main.js",
  "ui": {
    "entry": "ui/index.html",
    "dock": "right",
    "width": 300,
    "height": 260
  },
  "permissions": ["ui", "editor:read", "editor:write"],
  "engines": { "imark": ">=0.2.0" },
  "fields": [
    {
      "key": "keywords",
      "kind": "text",
      "label": "关键词",
      "description": "用英文逗号分隔。命中的行会在正文里被标出来。",
      "default": "TODO,FIXME,待办"
    },
    {
      "key": "highlightColor",
      "kind": "select",
      "label": "标记颜色",
      "default": "accent",
      "options": [
        { "value": "accent", "label": "主题强调色" },
        { "value": "warn", "label": "警示色" }
      ]
    }
  ],
  "actions": [{ "id": "refresh", "label": "重新扫描" }],
  "statusBar": [
    {
      "id": "todo",
      "label": "待办",
      "icon": "list",
      "action": "refresh",
      "tooltip": "重新扫描当前文档里的待办"
    }
  ]
}
