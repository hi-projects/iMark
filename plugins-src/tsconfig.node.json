{
  // node main 层的独立 TS 工程(CommonJS)。
  //
  // 刻意**不挂到根 tsconfig 的 references**:插件的产物是 userData 下的独立包,
  // 不是应用 bundle 的一部分;而且插件会 emit(要 main.js),应用那两个工程是 noEmit,
  // 混在一起会让 emit 落进源码树。
  //
  // rootDir 固定为仓库根,是为了让输出路径可预测:
  //   plugins-src/git-sync/main.ts → plugins-src/dist/node/plugins-src/git-sync/main.js
  // 同时把被依赖的 ../src/shared/*.ts 也一起编译(它们的产物我们直接忽略)。
  // 之所以必须把 shared 纳进来,是因为插件 import 了 ImkApi / PluginTarget 这些类型;
  // 它们全是 `import type`,编译后会被完全擦除,产物里不会有任何 require('@shared/…')。
  "compilerOptions": {
    "target": "ES2022",
    "lib": ["ES2022"],
    "module": "CommonJS",
    "moduleResolution": "node",
    "types": ["node"],
    "strict": true,
    "noUnusedLocals": true,
    "noUnusedParameters": true,
    "noImplicitOverride": true,
    "skipLibCheck": true,
    "esModuleInterop": true,
    "forceConsistentCasingInFileNames": true,
    // 插件 import 了 @shared/pluginApi → @shared/plugins → @shared/pluginPackage,
    // 而后者 import 了共用的 pluginFormat.json,所以这个工程也要能解析 JSON。
    // 全是 import type,产物里不会留下任何 require —— 编译出来的 JSON 副本躺在
    // dist/ 里没人读,而 dist/ 本来就被打包器排除在外。
    "resolveJsonModule": true,
    "rootDir": "..",
    "outDir": "dist/node",
    "declaration": false,
    "sourceMap": false,
    "baseUrl": ".",
    "paths": {
      "@shared/*": ["../src/shared/*"]
    }
  },
  // 新增插件一定要加进来:漏了这里 typecheck:plugins 会一字不报地跳过它,
  // 而 build-plugins.mjs 仍会照目录把它打出去(读不到编译产物才报错)
  "include": ["git-sync/**/*.ts"]
}
