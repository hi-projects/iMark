{
  // render 层:注入主窗口渲染进程的普通脚本。
  // 没有 Node 类型(types: []),只有 DOM/CM6 类型 —— 系统能力必须走 imk.main。
  "compilerOptions": {
    "target": "ES2022",
    "lib": ["ES2022", "DOM"],
    "module": "ES2022",
    "moduleResolution": "node",
    "types": [],
    "strict": true,
    "noUnusedLocals": true,
    "noUnusedParameters": true,
    "noImplicitOverride": true,
    "skipLibCheck": true,
    "esModuleInterop": true,
    "forceConsistentCasingInFileNames": true,
    "resolveJsonModule": true,
    "rootDir": "..",
    "outDir": "dist/render",
    "declaration": false,
    "sourceMap": false,
    "baseUrl": ".",
    "paths": {
      "@shared/*": ["../src/shared/*"]
    }
  },
  "include": ["render.d.ts", "todo-marks/**/*.ts", "note-embed/render.ts", "ai-for-edit/render.ts"]
}
