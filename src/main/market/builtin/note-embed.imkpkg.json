{
  "format": "imk-plugin",
  "formatVersion": 1,
  "manifest": {
    "id": "note-embed",
    "name": "笔记引用面板",
    "description": "在自己的窗口里浏览当前仓库,把某篇笔记的内容插进正在写的这篇。沙箱插件样板。",
    "version": "1.0.0",
    "kind": "sandboxed",
    "fields": [
      {
        "key": "maxPreview",
        "kind": "number",
        "label": "预览字数上限",
        "description": "面板右侧预览一篇笔记时最多显示多少个字符。",
        "default": 2000,
        "min": 200,
        "max": 20000
      }
    ],
    "actions": [
      {
        "id": "toggle",
        "label": "打开 / 收起面板"
      }
    ],
    "author": "iMark",
    "main": "main.js",
    "permissions": [
      "ui",
      "vault:read",
      "editor:write"
    ],
    "engines": {
      "imark": ">=0.2.0"
    },
    "statusBar": [
      {
        "id": "panel",
        "label": "引用面板",
        "icon": "file",
        "action": "toggle",
        "tooltip": "打开笔记引用面板"
      }
    ],
    "ui": {
      "entry": "ui/index.html",
      "width": 720,
      "height": 520,
      "minWidth": 420,
      "minHeight": 320
    }
  },
  "files": {
