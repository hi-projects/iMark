{
  "format": "imk-plugin",
  "formatVersion": 1,
  "manifest": {
    "id": "todo-marks",
    "name": "待办标记",
    "description": "把正文里的 TODO / FIXME 标出来并列在侧栏,点一条跳到那一行。编辑器扩展点 + 停靠面板的样板。",
    "version": "1.0.0",
    "kind": "sandboxed",
    "fields": [
      {
        "key": "keywords",
        "kind": "text",
        "label": "关键词",
        "description": "用英文逗号分隔。命中的行会在正文里被标出来。",
        "default": "TODO,FIXME,待办"
      },
      {
        "key": "highlightColor",
        "kind": "select",
        "label": "标记颜色",
        "default": "accent",
        "options": [
          {
            "value": "accent",
            "label": "主题强调色"
          },
          {
            "value": "warn",
            "label": "警示色"
          }
        ]
      }
    ],
    "actions": [
      {
        "id": "refresh",
        "label": "重新扫描"
      }
    ],
    "author": "iMark",
    "main": "main.js",
    "permissions": [
      "ui",
      "editor:read",
      "editor:write"
    ],
    "engines": {
      "imark": ">=0.2.0"
    },
    "statusBar": [
      {
        "id": "todo",
        "label": "待办",
        "icon": "list",
        "action": "refresh",
        "tooltip": "重新扫描当前文档里的待办"
      }
    ],
    "ui": {
      "entry": "ui/index.html",
      "dock": "right",
      "width": 300,
      "height": 260
    }
  },
  "files": {
    "README.md": {
      "encoding": "base64",
      "size": 2175,
      "sha256": "119666204ee46dc44f61e3018398e59edc7437b04378cf0d291d12ca12a8b9f0"
    },
    "main.js": {
      "encoding": "base64",
      "size": 5012,
      "sha256": "70e3b9822f75f1ba04e7b28655d121d79df63d203eefa712ef322c9f74c84511"
    },
    "ui/index.html": {
      "encoding": "base64",
      "size": 476,
      "sha256": "2e93304818da17fc60c323a3ddff0a552ce44487be1612a9e7a464e3d1ba3406"
    },
    "ui/style.css": {
      "encoding": "base64",
      "size": 1434,
      "sha256": "6992282fa8f50c49862dcc23e89e2b86beca57073f4d7e4403185ce2e0c0300e"
    }
  },
  "data": {
    "README.md": "",
