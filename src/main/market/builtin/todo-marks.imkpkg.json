{
  "format": "imk-plugin",
  "formatVersion": 1,
  "manifest": {
    "id": "todo-marks",
    "name": "待办标记",
    "description": "把正文里的 TODO、FIXME 标出来并列在侧栏，点一条跳到那一行。编辑器扩展点 + 停靠面板的样板。",
    "version": "2.0.0",
    "render": {
      "entry": "main.js"
    },
    "author": "iMark",
    "engines": {
      "imark": ">=0.2.0"
    },
    "fields": [
      {
        "key": "keywords",
        "kind": "text",
        "label": "关键词",
        "description": "用英文逗号分隔。命中的行会在正文里被标出来。",
        "default": "TODO,FIXME,待办"
      },
      {
        "key": "highlightColor",
        "kind": "select",
        "label": "标记颜色",
        "default": "accent",
        "options": [
          {
            "value": "accent",
            "label": "主题强调色"
          },
          {
            "value": "warn",
            "label": "警示色"
          }
        ]
      }
    ],
    "actions": [
      {
        "id": "refresh",
        "label": "重新扫描"
      }
    ],
    "statusBar": [
      {
        "id": "todo",
        "label": "待办",
        "icon": "list",
        "action": "refresh",
        "tooltip": "重新扫描当前文档里的待办"
      }
    ]
  },
  "files": {
    "README.md": {
      "encoding": "base64",
      "size": 1853,
      "sha256": "4fa4f4a03a84070cbaf42ecf298e644a62dcb1f5d2cf487320e3ac537ab2ef48"
    },
    "main.js": {
      "encoding": "base64",
      "size": 6308,
      "sha256": "dd43b5717272459ea1ca9ab921efb2ac42d8849f8e1495c2a5c5f36dbf468e76"
    }
  },
  "data": {
    "README.md": "",
    "main.js": ""
  },
  "integrity": "45d38dfaffb186761393effa7fd488d510e01ebccf51c73f8b193d71ab5b181f"
}
