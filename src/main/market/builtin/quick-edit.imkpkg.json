{
  "format": "imk-plugin",
  "formatVersion": 1,
  "manifest": {
    "id": "quick-edit",
    "name": "Advanced Table",
    "description": "在光标所在行的左侧放一个「+」按钮，点开即可插入表格；插入后可直接在渲染出的表格单元格里输入。",
    "version": "1.0.0",
    "main": {
      "mode": "restricted",
      "entry": "main.js"
    },
    "permissions": [],
    "author": "iMark 官方",
    "engines": {
      "imark": ">=0.1.0"
    },
    "fields": [],
    "actions": [],
    "lineMenu": [
      {
        "id": "table",
        "label": "表格",
        "action": "insert-table",
        "dialog": {
          "title": "插入表格",
          "confirmLabel": "确定",
          "fields": [
            {
              "key": "rows",
              "kind": "number",
              "label": "行数",
              "default": 3,
              "min": 1,
              "max": 50,
              "description": "含表头：第一行是表头，第二行是 Markdown 表格必需的分隔行，之后才是内容行。填 3 得到 1 行表头 + 2 行内容。"
            },
            {
              "key": "cols",
              "kind": "number",
              "label": "列数",
              "default": 3,
              "min": 1,
              "max": 20
            }
          ]
        }
      }
    ]
  },
  "files": {
    "README.md": {
      "encoding": "base64",
      "size": 6692,
      "sha256": "187cf3c76ce54418638d021f80d1b2f4ef090d1c63079a76b8967a360d88b7a1"
    },
    "main.js": {
      "encoding": "base64",
      "size": 3874,
      "sha256": "afc3ff16da616dbf51430de5daa3285d9ab435e13f463d0ee8ae8e992d07a7a2"
    }
  },
  "data": {
    "README.md": "",
    "main.js": ""
  },
  "integrity": "8bf43af79c151b5f7a5bccda5fe0c15057bfe735dbbbfe382126e22950818e62"
}
