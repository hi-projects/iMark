{
  "format": "imk-plugin",
  "formatVersion": 1,
  "manifest": {
    "publisher": "imark",
    "name": "quick-edit",
    "version": "1.0.0",
    "displayName": "快速编辑",
    "description": "在行首「+」菜单里插入一张 Markdown 表格",
    "author": "iMark",
    "engines": {
      "imark": "^1.0.0"
    },
    "main": "./main.js",
    "activationEvents": [
      "onCommand:imark.quick-edit.insertTable"
    ],
    "capabilities": {},
    "contributes": {
      "commands": [
        {
          "command": "imark.quick-edit.insertTable",
          "title": "插入表格",
          "category": "快速编辑",
          "detail": "在光标行下方插入一张空表，光标落在第一个表头单元格"
        }
      ],
      "imark.lineMenu": [
        {
          "id": "table",
          "label": "表格",
          "command": "imark.quick-edit.insertTable",
          "dialog": {
            "title": "插入表格",
            "confirmLabel": "插入",
            "fields": [
              {
                "key": "rows",
                "kind": "number",
                "label": "行数（含表头）",
                "default": 3,
                "min": 1,
                "max": 50
              },
              {
                "key": "cols",
                "kind": "number",
                "label": "列数",
                "default": 3,
                "min": 1,
                "max": 20
              }
            ]
          }
        }
      ]
    }
  },
  "files": {
    "README.md": {
      "encoding": "base64",
      "size": 7309,
      "sha256": "aa5f11e868ee066c4deb949b0a55ce6f901315dadcab5eb0db82cbacd8aa8ba9"
    },
    "main.js": {
      "encoding": "base64",
      "size": 4589,
      "sha256": "efb90866343f3e38c24075c563f33477a10e154b71f2e527fcb9e0730e4f396b"
    }
  },
  "data": {
    "README.md": "",
    "main.js": ""
  },
  "integrity": "95df83f11c58e69c8bf12975ce214ad083fc2875302345ce4ac3bdefcf37bc55"
}
